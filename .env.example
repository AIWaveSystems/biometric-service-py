# Copia este archivo a .env y rellena los valores.
# El servicio no arranca si faltan DATABASE_URL, JWT_SECRET, PORTAL_USER o PORTAL_PASSWORD.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Cadena de conexion de SQLAlchemy. Obligatoria.
# Crea la base con: python scripts/create_db.py
DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/auth-biometric

# Pool de conexiones. Con miles de peticiones por minuto el pool por defecto de
# SQLAlchemy (5) se agota y las peticiones se encolan. Regla practica:
# DB_POOL_SIZE >= workers de uvicorn x 4. Vigila max_connections de PostgreSQL:
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x n_procesos debe caber en ese limite.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Segundos tras los que se recicla una conexion inactiva. Evita que un cortafuegos
# o el propio PostgreSQL cierren conexiones que el pool cree vivas.
DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------
# Clave de firma de los JWT. Obligatoria. Usa una cadena larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla invalida todas las sesiones abiertas.
JWT_SECRET=

# Algoritmo de firma. HS256 es simetrico y suficiente para un despliegue unico.
JWT_ALGORITHM=HS256

# Vigencia del token del PORTAL (scope "portal"), el que da acceso a /api/*.
# Es la credencial del operador; 60 minutos es un valor comodo.
JWT_EXPIRE_MINUTES=60

# Vigencia del token de SESION de usuario (scope "user"), el que emite un login
# biometrico o por contrasena. Deliberadamente corto: identifica a la persona,
# no al operador, y no sirve para acceder a /api/*.
SESSION_EXPIRE_MINUTES=15

# ---------------------------------------------------------------------------
# Umbral facial
# ---------------------------------------------------------------------------
# Similitud coseno minima entre el rostro capturado y la mejor plantilla (SFace).
# Rango util 0..1. Subirlo = mas seguro y mas falsos rechazos.
FACE_THRESHOLD=0.363

# ---------------------------------------------------------------------------
# Umbrales de voz
# ---------------------------------------------------------------------------
# VIA PRINCIPAL: similitud coseno entre embeddings de locutor (ResNet34 de
# WeSpeaker sobre VoxCeleb). Se usa siempre que el usuario tenga embedding
# matriculado y el modelo este descargado (python scripts/fetch_models.py).
#
# Este modelo trae la poblacion de fondo DENTRO: no construye un UBM por usuario,
# asi que no depende de cuantas personas haya en tu base ni cuesta O(N).
#
# MEDIDO contra el unico impostor HUMANO disponible:
#   mismo hablante, peor caso:   0.411
#   voz ajena humana, mejor:     0.270
#   margen: +0.141
#
# ATENCION: un margen de 0.141 medido con UN solo impostor no permite afirmar
# nada sobre la tasa de error real. Un margen sano para produccion pasa de 0.25 y
# se mide con decenas de personas.
#
# El modelo anterior (CAM++) estaba ROTO y no se detecto porque toda la
# validacion usaba audio sintetico: puntuaba 0.9006 entre dos personas distintas
# y 0.95 entre el titular y un impostor, por encima del 0.93 titular-titular.
# Anade voces reales a datos_otros/ y remide con:
#   python scripts/diagnose_voice_db.py <carpeta_con_wavs>
VOICE_EMBEDDING_THRESHOLD=0.35

# Impide matricular la MISMA voz en dos cuentas. Sin esto una sola grabacion abre
# las dos y parece que "el sistema acepta a cualquiera", cuando en realidad esta
# acertando: son la misma persona. Medido en esta base, dos cuentas de la misma
# voz puntuaban 0.916 entre si; una voz ajena se quedaba en 0.05-0.23.
#
# El umbral es el MISMO que el de verificacion a proposito: si una voz nueva
# alcanzaria el umbral contra otra cuenta, esa cuenta podria entrar aqui.
VOICE_DUPLICATE_THRESHOLD=0.35

# true = rechazar con 409 la matricula de una voz ya registrada.
# false = permitirla pero devolver duplicate_of en la respuesta. Solo para
# migraciones; dejarlo en false reabre el agujero.
VOICE_REJECT_DUPLICATES=true

# Via principal (scoring "ubm-map"): log-verosimilitud del locutor menos la del
# modelo de fondo. Se activa con 2+ locutores de fondo registrados.
#
# MEDIDO sobre 6 cuentas y 8 tomas frescas de la unica persona REAL registrada:
#   titular:    1.35 .. 2.32      otras cuentas: -1.28 .. 1.13
# Con el valor antiguo (0.4) se aceptaban 6 de 40 intentos: 15% de FAR. El titular
# SIEMPRE era la mejor coincidencia, asi que el fallo era el umbral, no el algoritmo.
#
# ATENCION: ESTE 1.2 NO ESTA VALIDADO CONTRA IMPOSTORES REALES. Las otras 5 cuentas
# de esa medida eran voces SINTETICAS (TTS). Separar TTS de habla real es facil, asi
# que el 0% de FAR resultante es optimista. Ademas el margen es de solo 0.22 (peor
# genuino 1.35 frente a mejor impostor 1.13) sobre un rango genuino de ~1.0: es
# fragil incluso con esa poblacion facil.
#
# 1.2 es un SUELO, no un valor calibrado: es mejor que 0.4, que estaba medido como
# malo. Antes de produccion registra 3+ PERSONAS REALES distintas y remide:
#   python scripts/diagnose_voice_db.py <carpeta_con_wavs>
VOICE_LLR_THRESHOLD=1.2

# Modo de reserva (scoring "gmm-z"), solo cuando NO hay suficientes locutores
# para construir el UBM.
#
# ATENCION: este modo NO verifica de forma significativa. Medido con datos reales,
# un impostor puntuo z=-2.444 frente a este umbral de -2.5: paso por 0.056. Y bajo
# adaptacion MAP el z-score da 50.4% de EER, o sea una moneda al aire.
#
# El UBM necesita 2+ locutores de fondo de PERSONAS DISTINTAS. Varias grabaciones
# del mismo sujeto no cuentan y empeoran el resultado. Un locutor SINTETICO de
# prueba (el que deja scripts/test_full_api.py) hace que se acepte a cualquiera,
# en silencio.
#
# Registra al menos 3 personas reales distintas con voz, y comprueba que la
# respuesta trae scoring="ubm-map". Detalles en el README, seccion
# "La poblacion de fondo".
VOICE_Z_THRESHOLD=-2.5

# Ventaja minima sobre la cohorte en el modo de reserva.
# Si la cohorte esta vacia este valor no se aplica (ratio = null) y solo decide
# el z-score de arriba, que es insuficiente por si solo.
VOICE_RATIO_THRESHOLD=-3.0

# ---------------------------------------------------------------------------
# Desafio de digitos (anti-suplantacion por grabacion)
# ---------------------------------------------------------------------------
# Cuantos digitos pide el servidor en cada desafio. Con 4 digitos sobre los 10
# matriculados hay 5040 combinaciones ordenadas: una grabacion previa no puede
# responder a un desafio elegido despues de grabarla.
# Subirlo = mas seguro y mas lento de pronunciar.
VOICE_CHALLENGE_DIGITS=4

# Segundos de vida de un desafio emitido. Es de un solo uso: consumirlo lo borra,
# acierte o falle. Deja margen para leerlo, hablarlo y subir el audio.
VOICE_CHALLENGE_TTL_SECONDS=60

# Errores de digito tolerados. 0 exige acertarlos todos.
# Si el rechazo de usuarios legitimos resulta alto, medir primero con
# scripts/test_digits.py y solo entonces subirlo a 1: pasar de 0 a 1 error sobre
# 4 digitos multiplica por ~37 la probabilidad de acertar al azar.
VOICE_CHALLENGE_MAX_ERRORS=0

# Ventaja minima en log-verosimilitud del digito ganador sobre el segundo.
# 0.0 solo exige que gane. Subirlo rechaza pronunciaciones ambiguas y aumenta
# el rechazo de usuarios legitimos; calibra con scripts/test_digits.py.
VOICE_CHALLENGE_MIN_MARGIN=0.0

# Los desafios se guardan en la tabla voice_challenges (PostgreSQL) y sobreviven
# a reinicios y a varios workers de uvicorn. Cada uno es de un solo uso.

# ---------------------------------------------------------------------------
# Deteccion de vida (parpadeo)
# ---------------------------------------------------------------------------
# Frames con rostro detectado necesarios para evaluar el parpadeo.
# El portal captura ~28 frames en 2.6 s.
LIVENESS_MIN_FACES=6

# Fraccion maxima de frames SIN rostro que se tolera en la rafaga.
# Superarla rechaza la captura: es la firma de una foto en movimiento.
# Bajarlo = mas resistente a suplantacion y mas exigente con el usuario.
LIVENESS_MAX_GAP_RATIO=0.4

# ---------------------------------------------------------------------------
# Anti-replay y limitacion de intentos
# ---------------------------------------------------------------------------
# Segundos durante los que se recuerda el hash de una captura biometrica.
# Reenviar la misma rafaga o el mismo audio dentro de la ventana devuelve 409.
# Solo detecta el reenvio literal, NO una grabacion reproducida por altavoz.
# Para eso esta el desafio de digitos de mas arriba: el analisis pasivo del canal
# se midio y no separa una voz en directo de la misma voz por altavoz.
REPLAY_WINDOW_SECONDS=300

# Intentos de login permitidos por ventana, por IP y usuario. Al superarlos: 429.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origenes permitidos, separados por comas. Vacio = no se anade el middleware
# y solo funciona el mismo origen, que es lo correcto si sirves el portal desde
# este mismo servicio. Ejemplo: https://portal.midominio.com,http://localhost:5173
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# API keys (integraciones externas)
# ---------------------------------------------------------------------------
# Pimienta adicional para hashear secretos de API key. Si se deja vacia, usa JWT_SECRET.
# Cambiarla invalida todas las API keys existentes.
API_KEY_PEPPER=

# Validez por defecto al crear una API key desde el portal (dias).
API_KEY_DEFAULT_DAYS=365

# ---------------------------------------------------------------------------
# Credenciales del portal
# ---------------------------------------------------------------------------
# Usuario inicial del portal si la tabla portal_users esta vacia (bootstrap).
# Despues puedes crear mas operadores desde la pestaña "Operadores".
# El portal usa JWT (Authorization: Bearer). Las apps externas usan X-API-Key.
PORTAL_USER=admin
PORTAL_PASSWORD=

# Credenciales de /docs, /redoc y /openapi.json (Basic Auth).
# Si se dejan vacias, heredan las del portal.
DOCS_USER=
DOCS_PASSWORD=
